{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "text-work",
  "scopeName": "source.text-work",
  "patterns": [
    { "include": "#password" },
    { "include": "#comments" },
    { "include": "#quotedText" },
    { "include": "#links" },
    { "include": "#uuid" },
    { "include": "#numbers" },
    { "include": "#listMarkers" },
    { "include": "#colorWords" },
    { "include": "#tags" },
    { "include": "#labels" },
    { "include": "#abbreviations" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "password": {
      "patterns": [
        { "name": "text-work.password", "match": "\\S+(?=\\s+@pass\\b)" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "text-work.comment", "match": "\\s//.*$" },
        { "name": "text-work.comment", "match": "\\s--.*$" }
      ]
    },
    "quotedText": {
      "patterns": [
        {
          "name": "text-work.quoted-text",
          "begin": "\"",
          "end": "\"|(?=^--- ✄)",
          "patterns": [
            { "include": "#links" },
            { "match": "\\\\.", "name": "text-work.quoted-text" }
          ]
        },
        {
          "name": "text-work.quoted-text",
          "begin": "(?<![\\p{L}\\p{N}_])'",
          "end": "'(?![\\p{L}\\p{N}_])|(?=^--- ✄)",
          "patterns": [
            { "include": "#links" },
            { "match": "\\\\.", "name": "text-work.quoted-text" }
          ]
        }
      ]
    },
    "links": {
      "patterns": [
        { "name": "text-work.link", "match": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}\\b" },
        { "name": "text-work.link", "match": "\\bhttps?://[\\w\\-.]+(?:/[\\w\\-./?%&=]*)?\\b" }
      ]
    },
    "uuid": {
      "patterns": [
        { "name": "text-work.uuid", "match": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(\\$|€)?\\b([0-9]+(\\.[0-9]+)?)(k)?\\b",
          "captures": { "2": { "name": "text-work.number" } }
        }
      ]
    },
    "listMarkers": {
      "patterns": [
        {
          "match": "^(\\s*)([\\*\\-•▪▫◦‣⁃]\\s|\\d+\\.\\s|[a-zA-Z]+\\.\\s|\\.\\s)",
          "captures": { "2": { "name": "text-work.list-marker" } }
        }
      ]
    },
    "colorWords": {
      "patterns": [
        { "name": "text-work.green-words", "match": "(?i)\\b(green|true|ok|good|done|passed|eligible|yes|prod|production)\\b" },
        { "name": "text-work.red-words", "match": "(?i)\\b(red|false|fail|failed|error|no|not\\s+eligible|sun|sat)\\b" },
        { "name": "text-work.yellow-words", "match": "(?i)\\b(yellow|dev)\\b" },
        { "name": "text-work.orange-words", "match": "(?i)\\b(orange)\\b" },
        { "name": "text-work.blue-words", "match": "(?i)\\b(blue|february|feb|march|mar|april|apr|may|june|jun|july|jul|august|aug|september|sep|october|oct|november|nov|december|dec)\\b" },
        { "name": "text-work.violet-words", "match": "(?i)\\b(violet|purple|qa|uat|monday|mon|tuesday|tue|wednesday|wed|thursday|thu|friday|fri|saturday|sunday)\\b" },
        { "name": "text-work.magenta-words", "match": "(?i)\\b(status|cp|mv|tf|npm|npx|python\\d*|terraform|echo|git|ssh|if|else|run|install|pull|push)\\b" }
      ]
    },
    "tags": {
      "patterns": [
        { "name": "text-work.tag", "match": "(?<![A-Za-z0-9_])@[A-Za-z0-9_-]+" },
        { "name": "text-work.yellow-words", "match": "(?i)\\bis[A-Z][a-zA-Z]*\\b" }
      ]
    },
    "labels": {
      "patterns": [
        { "name": "text-work.label", "match": "^\\s*[^:\\s][^:]*(?=:)" },
        { "name": "text-work.label", "match": "(?i)\\bwarning\\b" }
      ]
    },
    "abbreviations": {
      "patterns": [
        { "name": "text-work.abbreviation", "match": "\\b(?!(?i:done|prod)\\b)([A-Z\\d]{2,}|[\\w.]*_[\\w.]*)\\b" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "text-work.punctuation", "match": "[-=\\|,.:;(){}\\[\\]\"']" },
        { "name": "text-work.symbol", "match": "[!$€?]" }
      ]
    }
  }
}
